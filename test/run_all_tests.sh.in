#!/usr/bin/env bash
#
# Auto-generated by CMake from test/run_all_tests.sh.in -- do not edit directly.
#
# Runs every GoogleTest executable directly, bypassing ctest's PRE_TEST
# discovery (which re-launches every test binary -- and thus re-initializes the
# GPU runtime -- just to enumerate cases). Each binary is run from its own
# directory so the copied "resources" folder is found.
#
# Usage:
#   ./run_all_tests.sh                       # run all tests
#   ./run_all_tests.sh --gtest_filter=Cube.* # forward any args to each binary
#
set -u

# Directory this script lives in (the CMake build root).
BUILD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

extra_args=("$@")

pass=0
fail=0
failed_tests=()

while IFS= read -r -d '' test_bin; do
    rel="${test_bin#"$BUILD_DIR"/}"
    echo "==================================================================="
    echo "Running: ${rel}"
    echo "==================================================================="
    if [[ ${#extra_args[@]} -gt 0 ]]; then
        ( cd "$(dirname "$test_bin")" && "./$(basename "$test_bin")" "${extra_args[@]}" )
    else
        ( cd "$(dirname "$test_bin")" && "./$(basename "$test_bin")" )
    fi
    if [[ $? -eq 0 ]]; then
        ((pass++))
    else
        ((fail++))
        failed_tests+=("${rel}")
    fi
    echo
done < <(find "$BUILD_DIR" -type f -name '*_test' -executable -print0 | sort -z)

echo "==================================================================="
echo "Summary: ${pass} passed, ${fail} failed"
if [[ ${fail} -gt 0 ]]; then
    printf '  FAILED: %s\n' "${failed_tests[@]}"
    exit 1
fi
