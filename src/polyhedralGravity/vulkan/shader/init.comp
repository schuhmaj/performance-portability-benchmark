#version 450

#ifndef FloatType
#define FloatType double
#define FloatType3 dvec3
#endif

layout (local_size_x = 256) in;

layout(binding = 0) readonly buffer bufVertices { FloatType3 vertices[]; };
layout(binding = 1) readonly buffer bufFaces { uvec3 faces[]; };

layout(binding = 2) buffer bufNormals { FloatType3 normals[]; };

layout(push_constant) uniform PushConstants {
    FloatType3 point;
    uint num_faces;
} push_const;

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index >= push_const.num_faces) {
        return;
    }

    FloatType3 Face[3] = {
    vertices[faces[index][0]],
    vertices[faces[index][1]],
    vertices[faces[index][2]]
    };

    // The plane unit normals N_p are the only per-face property that is cached
    normals[index] = normalize(cross(Face[1] - Face[0], Face[2] - Face[1]));
}
