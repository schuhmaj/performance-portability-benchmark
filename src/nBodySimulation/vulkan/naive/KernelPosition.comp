#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Positions {
    vec3 positions[];
};

layout(std430, binding = 1) readonly buffer Velocities {
    vec3 velocities[];
};

layout(std430, binding = 2) buffer Forces {
    vec3 forces[];
};

layout(std430, binding = 3) buffer OldForces {
    vec3 oldForces[];
};

layout(push_constant) uniform ParamsPos {
    vec3 globalForce;
    float dt;
    uint numParticles;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numParticles) {
        return;
    }

    float m = 1.0;

    vec3 force = forces[i];
    oldForces[i] = force;
    forces[i] = pc.globalForce;

    vec3 velocityPart = velocities[i] * pc.dt;
    float tt2m = (pc.dt * pc.dt) / (2.0 * m);
    vec3 forcePart = force * tt2m;
    vec3 displacement = velocityPart + forcePart;

    positions[i] += displacement;
}