#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Velocities {
    vec3 velocities[];
};

layout(std430, binding = 1) readonly buffer Forces {
    vec3 forces[];
};

layout(std430, binding = 2) readonly buffer OldForces {
    vec3 oldForces[];
};

layout(push_constant) uniform ParamsVel {
    float dt;
    float numParticlesF;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint numParticles = floatBitsToUint(pc.numParticlesF);
    if (i >= numParticles) {
        return;
    }

    float m = 1.0;

    vec3 force = forces[i] + oldForces[i];
    float t2m = pc.dt / (2.0 * m);
    vec3 velChange = force * t2m;

    velocities[i] += velChange;
}