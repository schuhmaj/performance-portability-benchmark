#version 450
layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Positions {
    vec4 positions[];
};

layout(std430, binding = 1) buffer Histogram {
    uint histogram[];
};

layout(std430, binding = 2) buffer ParticleIdx {
    ivec2 particleIdx[]; // vec2 is only 8 byte aligned so it works here
    // idx 0 : cellIdx
    // idx 1 : slot
}; 

// push_constant is 16 byte aligned, std140 like
layout(push_constant) uniform ParamsForce {
    uint numParticles;
    // cell counts
    int cCount_x;
    int cCount_y;
    int cCount_z;
    // boxMin
    float bMin_x;
    float bMin_y;
    float bMin_z;
    // boxSize
    float bSize_x;
    float bSize_y;
    float bSize_z;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.numParticles) {
        return;
    }

    vec3 pi = positions[gid].xyz;

    int gridIdx_x = int(clamp(int((pi.x - pc.bMin_x) / pc.bSize_x * pc.cCount_x), 0, pc.cCount_x - 1));
    int gridIdx_y = int(clamp(int((pi.y - pc.bMin_y) / pc.bSize_y * pc.cCount_y), 0, pc.cCount_y - 1));
    int gridIdx_z = int(clamp(int((pi.z - pc.bMin_z) / pc.bSize_z * pc.cCount_z), 0, pc.cCount_z - 1));
    int c = gridIdx_x + gridIdx_y * pc.cCount_x + gridIdx_z * pc.cCount_x * pc.cCount_y;

    int slot = int(atomicAdd(histogram[c], 1));

    particleIdx[gid] = ivec2(c, slot);
}