#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ParticleIdx {
    ivec2 particleIdx[];
    // idx 0 : cellIdx
    // idx 1 : slot
};

layout(std430, binding = 1) buffer IdCells {
    uint idCells[];
};

layout(std430, binding = 2) readonly buffer Starts {
    uint starts[];
};

layout(push_constant) uniform ParamsPos {
    uint numParticles;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numParticles) {
        return;
    }

    ivec2 data = particleIdx[i];
    int cell = data.x;
    int slot = data.y;

    uint idx = starts[cell] + slot;

    idCells[idx] = i;
}