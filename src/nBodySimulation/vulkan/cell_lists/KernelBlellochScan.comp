#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Data {
    uint data[];
}

layout(std430, binding = 1) buffer BlockSums {
    uint blockSums[];
}

layout(push_constant) uniform ParamsPos {
    uint total_size;
} pc;

shared uint tile[256];
const uint BLOCK_SIZE = 256;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x
    uint block = gl_WorkGroupID.x;

    if (gid >= pc.total_size) {
        return;
    }

    // -----------------------------------------------------------------------------------
    // load batch into shared memory
    // -----------------------------------------------------------------------------------
    tile[lid] = data[gid];
    barrier();

    // -----------------------------------------------------------------------------------
    // upsweep
    // -----------------------------------------------------------------------------------
    for (int off = 1; off < BLOCK_SIZE; off <<= 1) {
        int i = (lid + 1) * off * 2 - 1;
        if (i < BLOCK_SIZE) {
            tile[i] += tile[i - off];
        }
        barrier();
    }
    if (lid == BLOCK_SIZE - 1 && gid < pc.total_size) {
        blockSums[block] = tile[lid];
    }

    // -----------------------------------------------------------------------------------
    // downsweep
    // -----------------------------------------------------------------------------------
    if (lid == BLOCK_SIZE - 1) {
        tile[BLOCK_SIZE - 1] = 0;
    }
    barrier();

    for (int off = BLOCK_SIZE >> 1; off > 0; off >>= 1) {
        int i = (lid + 1) * off * 2 - 1;
        if (i < BLOCK_SIZE) {
            uint t = tile[i - off];
            tile[i - off] = tile[i];
            tile[i] += t;
        }
        barrier();
    }
    
    // -----------------------------------------------------------------------------------
    // write back
    // -----------------------------------------------------------------------------------
    data[gid] = tile[lid];
}
