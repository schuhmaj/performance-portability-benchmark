#version 450
layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Data {
    uint data[];
};

layout(std430, binding = 1) buffer BlockSums {
    uint blockSums[];
};

layout(push_constant) uniform ParamsPos {
    uint total_size;
    uint block_size;
} pc;

shared uint tile[1024];

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    uint block = gl_WorkGroupID.x;

    if (gid >= pc.total_size) {
        return;
    }

    // -----------------------------------------------------------------------------------
    // load batch into shared memory
    // -----------------------------------------------------------------------------------
    tile[lid] = data[gid];
    barrier();

    // -----------------------------------------------------------------------------------
    // upsweep
    // -----------------------------------------------------------------------------------
    for (uint off = 1; off < pc.block_size; off <<= 1) {
        uint i = (lid + 1) * off * 2 - 1;
        if (i < pc.block_size) {
            tile[i] += tile[i - off];
        }
        barrier();
    }
    if (lid == pc.block_size - 1 && gid < pc.total_size) {
        blockSums[block] = tile[lid];
    }

    // -----------------------------------------------------------------------------------
    // downsweep
    // -----------------------------------------------------------------------------------
    
    if (lid == pc.block_size - 1) {
        tile[pc.block_size - 1] = 0;
    }
    barrier();
    
    for (uint off = pc.block_size >> 1; off > 0; off >>= 1) {
        uint i = (lid + 1) * off * 2 - 1;
        if (i < pc.block_size) {
            uint t = tile[i - off];
            tile[i - off] = tile[i];
            tile[i] += t;
        }
        barrier();
    }
    
    // -----------------------------------------------------------------------------------
    // write back
    // -----------------------------------------------------------------------------------
    data[gid] = tile[lid];
}