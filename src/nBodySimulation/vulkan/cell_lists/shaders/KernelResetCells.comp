#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Cells {
    uint cells[];
};

layout(push_constant) uniform ParamsPos {
    uint total_size;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.total_size) {
        return;
    }
    
    cells[gid] = 0;
}