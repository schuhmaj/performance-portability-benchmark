#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Positions {
    vec4 positions[];
};

layout(std430, binding = 1) buffer Forces {
    vec4 forces[];
};

layout(std430, binding = 2) readonly buffer VerletLists {
    uint verletLists[];
};

layout(std430, binding = 3) readonly buffer NieghborsStarts {
    uint starts[];
};

layout(push_constant) uniform ParamsForce {
    uint numParticles;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.numParticles) { return; }

    uint start = starts[gid];
    uint end = starts[gid + 1];

    vec3 acc = vec3(0.0);

    const float sigma = 1.0;
    const float sigmaSquared = sigma * sigma;
    const float epsilon24 = 24.0; // 1.0 * 24.0

    vec3 pi = positions[gid].xyz;

    for (uint i = start; i < end; ++i) {
        uint j = verletLists[i];
        vec3 dr = pi - positions[j].xyz;
        float dr2 = dot(dr, dr);

        float invdr2 = 1.0 / dr2;
        float lj6 = sigmaSquared * invdr2;
        lj6 = lj6 * lj6 * lj6;
        float lj12 = lj6 * lj6;
        float lj12m6 = lj12 - lj6;
        float fac = epsilon24 * (lj12 + lj12m6) * invdr2;

        acc += dr * fac;
    }

    forces[gid].xyz = acc;
}
