#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Velocities {
    vec4 velocities[];
};

layout(std430, binding = 1) readonly buffer Forces {
    vec4 forces[];
};

layout(std430, binding = 2) readonly buffer OldForces {
    vec4 oldForces[];
};

layout(push_constant) uniform ParamsVel {
    float dt;
    uint numParticles;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numParticles) {
        return;
    }

    float m = 1.0;

    vec3 force = forces[i].xyz + oldForces[i].xyz;
    float t2m = pc.dt / (2.0 * m);
    vec3 velChange = force * t2m;

    velocities[i].xyz += velChange.xyz;
}