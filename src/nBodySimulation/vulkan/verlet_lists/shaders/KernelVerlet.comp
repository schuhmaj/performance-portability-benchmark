#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Positions {
    vec4 positions[];
};

layout(std430, binding = 1) buffer VerletLists {
    uint verletLists[];
};

layout(std430, binding = 2) readonly buffer NieghborsStarts {
    uint starts[];
};

layout(push_constant) uniform ParamsPos {
    uint numParticles;
    float radius;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.numParticles) { return; }

    uint index = starts[gid];
    uint end = starts[gid + 1];

    vec3 pi = positions[gid].xyz;
    
    for (uint i = 0; i < pc.numParticles; i++) {
        if (i == gid) { continue; }
        if (index == end) { break; }
        // calculate distance to see if this particle is a neighbor
        vec3 dr = pi - positions[i].xyz;
        float dr2 = dot(dr.xyz, dr.xyz);
        if (dr2 < pc.radius * pc.radius) {
            // if the particle is close enough, add it
            verletLists[index] = i;
            index += 1;
        }
    }
}