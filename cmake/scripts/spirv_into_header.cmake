# vulkan_to_header.cmake - Script executed at build time
# Do not call by itself

# Read the comma-separated hex numbers generated by glslc -mfmt=num
file(READ "${INPUT_FILE}" FILE_CONTENTS)

set(HEADER_TEXT
"#pragma once
#include <cstdint>

namespace ${NAMESPACE} {

inline constexpr uint32_t ${VAR_NAME}[] = {
${FILE_CONTENTS}
};

} // namespace ${NAMESPACE}
")

file(WRITE "${OUTPUT_FILE}" "${HEADER_TEXT}")
