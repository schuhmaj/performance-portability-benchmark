{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "~/modules/llvm/20.1.8",
        "CMAKE_INSTALL_RPATH": "~/modules/llvm/20.1.8/LIB",
        "LLVM_ENABLE_PROJECTS": "clang;compiler-rt;lld",
        "LLVM_ENABLE_RUNTIMES": "openmp;offload",
        "LLVM_TARGETS_TO_BUILD": "NVPTX;X86",
        "LLVM_ENABLE_Z3_SOLVER": "0",
        "LLVM_INCLUDE_BENCHMARKS": "0",
        "LLVM_INCLUDE_EXAMPLES": "0",
        "LLVM_INCLUDE_TESTS": "0",
        "CMAKE_INSTALL_RPATH_USE_LINK_PATH": "ON",
        "LLVM_ENABLE_OCAMLDOC": "OFF",
        "LLVM_ENABLE_BINDINGS": "OFF",
        "LLVM_TEMPORARILY_ALLOW_OLD_TOOLCHAIN": "OFF",
        "LLVM_BUILD_LLVM_DYLIB": "ON",
        "LLVM_ENABLE_DUMP": "OFF",
        "LLVM_PARALLEL_LINK_JOBS": "8"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "targets": "install"
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "default"
        }
      ]
    }
  ]
}