{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "abstract-base",
      "displayName": "Base (CPU)",
      "description": "Abstract base. Enables all paradigms that can run on a Linux machine without a GPU or special hardware.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",

        "PPB_ENABLE_VectorAddition": "ON",
        "PPB_ENABLE_MatrixMultiplication": "ON",
        "PPB_ENABLE_NBodySimulation": "ON",
        "PPB_ENABLE_NBodySimulation_naive": "ON",
        "PPB_ENABLE_NBodySimulation_cells": "ON",
        "PPB_ENABLE_NBodySimulation_verlet": "ON",
        "PPB_ENABLE_PolyhedralGravity": "ON",
        "PPB_ENABLE_Testing": "ON"
      }
    },
    {
      "name": "linux-cuda-llvm",
      "inherits": "abstract-base",
      "displayName": "Linux Cuda with LLVM",
      "description": "Enables all paradigms that can run on a Linux machine with CUDA support and LLVM as compiler",
      "binaryDir": "${sourceDir}/cmake-build-linux-cuda-llvm",
      "cacheVariables": {
        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_OpenMP": "ON",
        "PPB_ENABLE_AdaptiveCpp": "ON",
        "PPB_ENABLE_Vulkan": "ON",
        "PPB_ENABLE_Slang_Vulkan": "ON",
        "PPB_ENABLE_Slang_Cuda": "ON",
        "PPB_ENABLE_OpenCL": "ON",
        "PPB_ENABLE_Boost": "ON",
        "PPB_ENABLE_Kokkos": "ON",
        "PPB_ENABLE_Cuda": "ON",
        "PPB_ENABLE_Alpaka": "ON",
        "PPB_ENABLE_Metal": "OFF"
      }
    },
    {
      "name": "linux-cuda-nvhpc",
      "inherits": "abstract-base",
      "displayName": "Linux CUDA with NVHPC",
      "description": "Enables all paradigms that can run on a Linux machine with CUDA support and NVHPC as compiler toolchain",
      "binaryDir": "${sourceDir}/cmake-build-linux-cuda-nvhpc",
      "cacheVariables": {
        "PPB_ENABLE_OpenACC": "ON",
        "PPB_ENABLE_OpenMP": "OFF",
        "PPB_ENABLE_AdaptiveCpp": "ON",
        "PPB_ENABLE_Vulkan": "OFF",
        "PPB_ENABLE_Slang_Vulkan": "OFF",
        "PPB_ENABLE_Slang_Cuda": "ON",
        "PPB_ENABLE_OpenCL": "ON",
        "PPB_ENABLE_Boost": "ON",
        "PPB_ENABLE_Kokkos": "ON",
        "PPB_ENABLE_Cuda": "ON",
        "PPB_ENABLE_Alpaka": "ON",
        "PPB_ENABLE_Metal": "OFF"

      }
    },
    {
      "name": "macos-all",
      "inherits": "abstract-base",
      "displayName": "macOS",
      "description": "Enables everything that can run on macOS natively (including Metal, OpenCL, Vulkan, etc.). Excludes CUDA/OpenACC.",
      "binaryDir": "${sourceDir}/build/macos-all",
      "cacheVariables": {
        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_OpenMP": "ON",
        "PPB_ENABLE_AdaptiveCpp": "ON",
        "PPB_ENABLE_Vulkan": "ON",
        "PPB_ENABLE_Slang_Vulkan": "ON",
        "PPB_ENABLE_Slang_Cuda": "OFF",
        "PPB_ENABLE_OpenCL": "ON",
        "PPB_ENABLE_Boost": "ON",
        "PPB_ENABLE_Kokkos": "ON",
        "PPB_ENABLE_Cuda": "OFF",
        "PPB_ENABLE_Alpaka": "ON",
        "PPB_ENABLE_Metal": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-cuda-llvm",
      "configurePreset": "linux-cuda-llvm"
    },
    {
      "name": "linux-cuda-nvhpc",
      "configurePreset": "linux-cuda-nvhpc"
    },
    {
      "name": "macos-all",
      "configurePreset": "macos-all"
    }
  ]
}
