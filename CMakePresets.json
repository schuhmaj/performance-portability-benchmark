{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "CPU Implementation Only",
      "description": "Only the CPU Implementation is enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PPB_ENABLE_VectorAddition": "ON",
        "PPB_ENABLE_MatrixMultiplication": "ON",
        "PPB_ENABLE_NBodySimulation": "ON",
        "PPB_ENABLE_NBodySimulation_naive": "ON",
        "PPB_ENABLE_NBodySimulation_cells": "ON",
        "PPB_ENABLE_NBodySimulation_verlet": "ON",
        "PPB_ENABLE_PolyhedralGravity": "ON",
        "PPB_ENABLE_Testing": "ON"
      }
    },
    {
      "name": "abstract-base",
      "displayName": "Abstract Base",
      "description": "Abstract base. Switches everything ON. CUDA and HIP are automatically enabled/ disabled via CMake Language Detection (no need to set PPB_ENABLE_CUDA/HIP).",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",

        "PPB_ENABLE_VectorAddition": "ON",
        "PPB_ENABLE_MatrixMultiplication": "ON",
        "PPB_ENABLE_NBodySimulation": "ON",
        "PPB_ENABLE_NBodySimulation_naive": "ON",
        "PPB_ENABLE_NBodySimulation_cells": "ON",
        "PPB_ENABLE_NBodySimulation_verlet": "ON",
        "PPB_ENABLE_PolyhedralGravity": "ON",
        "PPB_ENABLE_Testing": "ON",

        "PPB_ENABLE_OpenACC": "ON",
        "PPB_ENABLE_OpenMP": "ON",
        "PPB_ENABLE_Stdpar": "ON",
        "PPB_ENABLE_AdaptiveCpp": "ON",
        "PPB_ENABLE_Vulkan": "ON",
        "PPB_ENABLE_Slang_Vulkan": "ON",
        "PPB_ENABLE_Slang_Cuda": "ON",
        "PPB_ENABLE_OpenCL": "ON",
        "PPB_ENABLE_Boost": "ON",
        "PPB_ENABLE_Kokkos": "ON",
        "PPB_ENABLE_Raja": "ON",
        "PPB_ENABLE_Alpaka": "ON",
        "PPB_ENABLE_Metal": "OFF"
      }
    },
    {
      "name": "cuda-llvm",
      "inherits": "abstract-base",
      "displayName": "Linux CUDA with LLVM",
      "description": "Switches OFF: OpenACC (and potentially Kokkos)",
      "binaryDir": "${sourceDir}/build-cuda-llvm",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CUDA_COMPILER": "nvcc",

        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_Stdpar": "OFF"
      }
    },
    {
      "name": "cuda-nvhpc",
      "inherits": "abstract-base",
      "displayName": "Linux CUDA with NVHPC",
      "description": "Switches OFF: OpenMP, Vulkan, Slang-Vulkan",
      "binaryDir": "${sourceDir}/build-cuda-nvhpc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "nvc",
        "CMAKE_CXX_COMPILER": "nvc++",
        "CMAKE_CUDA_COMPILER": "nvcc",

        "PPB_ENABLE_OpenMP": "OFF",
        "PPB_ENABLE_Vulkan": "OFF",
        "PPB_ENABLE_Slang_Vulkan": "OFF"
      }
    },
    {
      "name": "cuda-gcc",
      "inherits": "abstract-base",
      "displayName": "Linux CUDA with GCC",
      "description": "Switches OFF: OpenMP, Stdpar (GCC has no stdpar GPU offload)",
      "binaryDir": "${sourceDir}/build-linux-cuda-gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CUDA_COMPILER": "nvcc",

        "PPB_ENABLE_OpenMP": "OFF",
        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_Stdpar": "OFF"
      }
    },
    {
      "name": "rocm-amdclang-cdna",
      "inherits": "abstract-base",
      "displayName": "Linux ROCM with AMDCLANG (Compute Architecture)",
      "description": "Switches off: OpenACC, Slang-CUDA and Vulkan. Run the stdpar binaries with HSA_XNACK=1 (or configure PPB_Stdpar_Hip_InterposeAlloc=ON if XNACK is unavailable).",
      "binaryDir": "${sourceDir}/build-rocm-amdclang-cdna",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "amdclang",
        "CMAKE_CXX_COMPILER": "amdclang++",

        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_Slang_Cuda": "OFF",
        "PPB_ENABLE_Vulkan": "OFF",
        "PPB_ENABLE_Slang_Vulkan": "OFF"
      }
    },
    {
      "name": "rocm-llvm-cdna",
      "inherits": "abstract-base",
      "displayName": "Linux ROCM with LLVM (Compute Architecture)",
      "description": "Switches off: OpenACC, Stdpar, Slang-CUDA and Vulkan.",
      "binaryDir": "${sourceDir}/build-rocm-llvm-cdna",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",

        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_Slang_Cuda": "OFF",
        "PPB_ENABLE_Vulkan": "OFF",
        "PPB_ENABLE_Slang_Vulkan": "OFF",
        "PPB_ENABLE_Stdpar": "OFF"
      }
    },
    {
      "name": "rocm-amdclang-rdna",
      "inherits": "abstract-base",
      "displayName": "Linux ROCM with AMDCLANG (Consumer Architecture)",
      "description": "Switches off: OpenACC, Slang-CUDA. Stdpar uses allocation interposition (consumer GPUs lack HMM/XNACK).",
      "binaryDir": "${sourceDir}/build-rocm-amdclang-rdna",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "amdclang",
        "CMAKE_CXX_COMPILER": "amdclang++",

        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_Slang_Cuda": "OFF",
        "PPB_Stdpar_Hip_InterposeAlloc": "ON"
      }
    },
    {
      "name": "rocm-llvm-rdna",
      "inherits": "abstract-base",
      "displayName": "Linux ROCM with LLVM (Consumer Architecture)",
      "description": "Switches off: OpenACC, Slang-CUDA. Stdpar uses allocation interposition (consumer GPUs lack HMM/XNACK) and needs an upstream LLVM matching the ROCm headers (LLVM >= 21 for ROCm 7.x).",
      "binaryDir": "${sourceDir}/build-rocm-llvm-rdna",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",

        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_Slang_Cuda": "OFF",
        "PPB_ENABLE_Stdpar": "OFF"
      }
    },
    {
      "name": "intel",
      "inherits": "abstract-base",
      "displayName": "Linux SYCL with IntelLLVM",
      "description": "Switches off: OpenACC, Slang, Vulkan",
      "binaryDir": "${sourceDir}/build-intel",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "icx",
        "CMAKE_CXX_COMPILER": "icpx",

        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_Slang_Cuda": "OFF",
        "PPB_ENABLE_Vulkan": "OFF",
        "PPB_ENABLE_Slang_Vulkan": "OFF"
      }
    },
    {
      "name": "intel-beast",
      "inherits": "intel",
      "displayName": "Linux SYCL with IntelLLVM (pinned GCC libstdc++)",
      "description": "Like 'intel', but auto-pins icx/icpx to the GCC currently in PATH (e.g. a loaded gcc module) for libstdc++ and bakes its lib dir into the RPATH. The toolchain file derives the paths by invoking gcc/g++, so no manual environment setup is needed. Also enables OpenCL and points it at the oneAPI compiler's headers/loader (the 2023.x oneAPI layout doesn't ship a top-level include/CL, so FindOpenCL needs explicit hints). Switches OFF: Stdpar (oneAPI 2023.x has no -fsycl-pstl-offload; use the acpp route for stdpar on Intel GPUs).",
      "binaryDir": "${sourceDir}/build-intel-beast",
      "toolchainFile": "${sourceDir}/cmake/intel-gcc-toolchain.cmake",
      "cacheVariables": {
        "PPB_ENABLE_Alpaka": "OFF",
        "PPB_ENABLE_Stdpar": "OFF",
        "OpenCL_INCLUDE_DIR": "$env{CMPLR_ROOT}/linux/lib/oclfpga/host/include",
        "OpenCL_LIBRARY": "$env{CMPLR_ROOT}/linux/lib/libOpenCL.so",
        "oneDPL_DIR": "$env{DPL_ROOT}/lib/cmake/oneDPL"
      }
    },
    {
      "name": "macos",
      "inherits": "abstract-base",
      "displayName": "macOS",
      "description": "Switches OFF: OpenACC, Slang-CUDA, Stdpar (AppleClang has no GPU offload); Switches ON: Metal (Apple)",
      "binaryDir": "${sourceDir}/build-macos",
      "cacheVariables": {
        "PPB_ENABLE_OpenACC": "OFF",
        "PPB_ENABLE_Slang_Cuda": "OFF",
        "PPB_ENABLE_Stdpar": "OFF",
        "PPB_ENABLE_Metal": "ON"
      }
    }
  ]
}
